{
  "manifest_version": 3,
  "name": "AI Chat Exporter",
  "version": "3.1.0",
  "description": "Export chat conversations from ChatGPT, Claude, Copilot, Gemini, and Grok as Markdown or JSON.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
